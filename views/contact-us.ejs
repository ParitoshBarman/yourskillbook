            <script>
                let hambargerMenu = document.querySelector(".mobile-responsive-menu>.mean-bar>a");
                let hambargerMenulist = document.querySelector(".mobile-responsive-menu>.mean-bar > .mean-nav>.navbar-nav");

                hambargerMenulist.style.display = "none";


                hambargerMenu.addEventListener("click", () => {
                    console.log(hambargerMenulist.style.display);
                    if (hambargerMenulist.style.display == "none") {
                        hambargerMenulist.style.display = "";
                    }
                    else {
                        hambargerMenulist.style.display = "none";
                    }

                })


            </script>

            <script>
                let courseListPopUp = document.getElementsByClassName("form-select");


                async function fetchCourseList() {
                    const response = await fetch('https://yourskillbook.com/apiskill/course_list', {
                        method: 'POST',
                        body: JSON.stringify({ company_id: 1 })
                    });

                    let courses = await response.json()
                    courseListPopUp[0].innerHTML = null;
                    courseListPopUp[1].innerHTML = null;

                    let option = document.createElement('option')
                    option.value = "";
                    option.textContent = 'Select Course';

                    let option2nd = document.createElement('option')
                    option2nd.value = "";
                    option2nd.textContent = 'Select Course';

                    courseListPopUp[0].appendChild(option);
                    courseListPopUp[1].appendChild(option2nd);




                    courses.data.forEach(element => {
                        let option2 = document.createElement('option');
                        let option2nd2 = document.createElement('option');
                        option2.value = element.course_id;
                        option2.textContent = element.course_name;
                        courseListPopUp[0].appendChild(option2);

                        option2nd2.value = element.course_id;
                        option2nd2.textContent = element.course_name;
                        courseListPopUp[1].appendChild(option2nd2);
                    });

                }

                fetchCourseList();


                let course_enquiry_form = document.querySelector("#course_enquiry_form");


                course_enquiry_form.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    console.log("Submited...");

                    // Get form data
                    // const formData = {
                    //    student_name: document.querySelector('fname').value,
                    //    phone_no: document.querySelector('input[name="phone"]').value,
                    //    email_id: document.querySelector('input[name="email"]').value,
                    //    course_id: document.querySelector('textarea[name="message"]').value,
                    //    message: document.querySelector('textarea[name="message"]').value,
                    //       };
                    const formData = {
                        student_name: document.querySelector("#student_name").value,
                        phone_no: document.querySelector("#phone_no").value,
                        email_id: document.querySelector("#email_id").value,
                        course_id: document.querySelector("#course_id").value,
                        message: document.querySelector("#message").value,
                        company_id: 1
                    };
                    console.log(formData);
                    console.log("company_id", formData.company_id);

                    try {
                        const response = await fetch('https://yourskillbook.com/apiskill/course_enquiry', {
                            method: 'POST',
                            //   headers: {
                            //       'Content-Type': 'application/json'
                            //   },
                            body: JSON.stringify(formData)
                        });

                        // Check if the response is ok
                        if (response.ok) {
                            const result = await response.json();
                            console.log(result);
                            document.querySelector("#student_name").value = "";
                            document.querySelector("#phone_no").value = "";
                            document.querySelector("#email_id").value = "";
                            document.querySelector("#course_id").value = "";
                            document.querySelector("#message").value = "";
                            alert('Message sent successfully!');
                            // Clear form fields

                        } else {
                            throw new Error('Failed to send the message.');
                        }
                    } catch (error) {
                        alert('Error: ' + error.message);
                    }
                });


                let form = document.querySelector("form");
                form.addEventListener("submit", async (e) => {
                    e.preventDefault();

                    const formData = {
                        student_name: e.target[0].value,
                        phone_no: e.target[1].value,
                        email_id: e.target[2].value,
                        course_id: e.target[3].value,
                        message: e.target[4].value,
                        company_id: 1
                    };

                    console.log(formData);
                    console.log("company_id", formData.company_id);
                    try {
                        const response = await fetch('https://yourskillbook.com/apiskill/course_enquiry', {
                            method: 'POST',
                            //   headers: {
                            //       'Content-Type': 'application/json'
                            //   },
                            body: JSON.stringify(formData)
                        });

                        // Check if the response is ok
                        if (response.ok) {
                            const result = await response.json();
                            console.log(result);

                            e.target[0].value = "";
                            e.target[1].value = "";
                            e.target[2].value = "";
                            e.target[3].value = "";
                            e.target[4].value = "";
                            alert('Message sent successfully!');
                            // Clear form fields

                        } else {
                            throw new Error('Failed to send the message.');
                        }
                    } catch (error) {
                        alert('Error: ' + error.message);
                    }
                })

